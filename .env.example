# Riot API Key - obter em https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# PostgreSQL — DATABASE_URL
# IMPORTANTE: para o vínculo de PUUID entre LoL, TFT e Valorant funcionar, os
# TRÊS apps devem apontar DATABASE_URL para o MESMO banco Postgres (recomendado:
# o banco Neon usado pelo rank-valorant). Eles compartilham a tabela
# `linked_accounts`, criada automaticamente no boot.
DATABASE_URL=postgresql://user:password@host:port/database

# Porta (Railway preenche automaticamente)
PORT=3000

# Ambiente
NODE_ENV=development
